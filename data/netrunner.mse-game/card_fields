
##############################

card field:
	type: choice
	name: faction

	default: "neutral-{ side_of(card) }"
	default name: Neutral

	choice:
		name: anarch
		type: radio
		enabled: { is_runner_card() }
	choice:
		name: criminal
		type: radio
		enabled: { is_runner_card() }
	choice:
		name: shaper
		type: radio
		enabled: { is_runner_card() }

	choice:
		name: haas-bioroid
		type: radio
		enabled: { is_corp_card() }
	choice:
		name: jinteki
		type: radio
		enabled: { is_corp_card() }
	choice:
		name: nbn
		type: radio
		enabled: { is_corp_card() }
	choice:
		name: weyland
		type: radio
		enabled: { is_corp_card() }

	choice:
		name: adam
		type: radio
		enabled: { set.enable_minifactions and is_runner_card() }
	choice:
		name: apex
		type: radio
		enabled: { set.enable_minifactions and is_runner_card() }
	choice:
		name: sunny
		type: radio
		enabled: { set.enable_minifactions and is_runner_card() }

	show statistics: false
	card list name    : FAC
	card list column  : 0401
	card list visible : true
	card list width   : 100
	choice colors cardlist:
		haas-bioroid : rgb(138, 43, 226)
		jinteki      : rgb(220, 20, 60)
		nbn          : rgb(255, 140, 0)
		weyland      : rgb(0,   100, 0)
		neutral-corp   : rgb(128, 128, 128)
		neutral-runner : rgb(192, 192, 192)
		anarch   : rgb(255, 69, 0)
		criminal : rgb(65, 105, 225)
		shaper   : rgb(50, 205, 50)
		adam  : rgb(167, 156, 89)
		apex  : rgb(140, 72, 71)
		sunny : rgb(120, 97, 150)

	description: The faction.

# # # # # # # # # # # # # # # 

card field:
	type: image
	name: corners

# # # # # # # # # # # # # # # 

card field:
	type: image
	name: art
	show statistics: false
	description: The artwork/illustration. The dimensions / aspect ratio differ between card-types, but most are "horizontal rectangles".

# # # # # # # # # # # # # # # 

card field:
	type: choice
	name: influence
	initial: 0
	choice:
		name: 5
		type: radio
	choice:
		name: 4
		type: radio
	choice:
		name: 3
		type: radio
	choice:
		name: 2
		type: radio
	choice:
		name: 1
		type: radio
	choice:
		name: 0
		type: radio
	show statistics: false
	card list name    : INF
	card list column  : 0402
	card list visible : true
	card list width   : 40
	description: The influence cost (0–5).

############################## 

card field:
	type: text
	name: title
	identifying: true
	card list name    : Name
	card list column  : 0101
	card list visible : true
	card list width   : 150
	show statistics: false
	description: The card name.

# # # # # # # # # # # # # # # 

card field:
	type: choice
	name: unique
	initial: no
	choice: unique
	choice: no
	show statistics: false
	card list name    : ◆
	card list visible : true
	card list column  : 0901
	card list width   : 40
	description: Whether the installable card is unique (⬩). (Identities/Events/Operations are neither unique nor non-unique.)

##############################

card field:
	type: text
	name: cardtype
	default: to_upper(card_type_of()) + ": "
	show statistics: false
	card list name    : Card-Type
	card list visible : true
	card list column  : 0301
	card list width   : 100
	description: The card’s (single) card-type.

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: subtypes
	script:
		stylesheet
		add_subtype_dropdowns(value, type: card_type_of())
	show statistics: false
	card list name    : Sub-Types
	card list visible : false
	card list column  : 0302
	card list width   : 200
	description: The card’s (zero-or-more) subtypes; hyphen-separated (e.g. "Icebreaker - AI - Virus").

##############################

card field:
	type: text
	name: text
	multi line: true
	show statistics: false
	script:
		stylesheet
		format_rules_text(value)
	description: Rules text, sharing the textbox with any flavor text (press down/up arrows to move between them). You can search your set for fields with any abbreviation (e.g. "x:run", since "(te)x(t)" is a distinct subsequence).

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: flavor
	multi line: true
	show statistics: false
	script:
		stylesheet
		format_flavor_text(value)
	description: Flavor text, sharing the textbox with any rules text (press up/down arrows to move between them).

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: textbox
	multi line: true
	save value: false
	show statistics: false
	script: textbox_editor()
	description: The textbox, containing both rules text and flavor text. You can search your set for fields with any abbreviation (e.g. "x:run", since "(te)x(t)" is a distinct subsequence).

# Uses {combined_editor()} because the flavor text comes (if present) a line below the rules text (not at the bottom of the textbox).

##############################

card field:
	type: text
	name: cost
	show statistics: false
	card list name:    $$$
	card list visible: true
	card list column:  0201
	card list width:   40
	script: only_numerals(value)
	sort script: compare_numeral(value)
	description: The play/rez/install cost (in credits).

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: strength

	default     : if is_program(card) and not is_breaker(card.subtypes) then "-" else ""
	script      : only_numerals(value)
	sort script : compare_numeral(value)

	show statistics: false
	card list name    : STR
	card list visible : true
	card list column  : 0501
	card list width   : 10
	description: The base strength of ICE/Icebreakers. Can be "X". Should be "-" for nom-Icebreaker Programs.

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: memory

	default     : if is_program() then "1" else ""
	script      : only_numerals(value)
	sort script : compare_numeral(value)

	show statistics: false
	card list name    : MU
	card list visible : true
	card list column  : 0502
	card list width   : 10
	description: Programs’ memory usage (mostly 1, 2, or 0).

##############################

card field:
	type: text
	name: footer
	multi line: true
	show statistics: false
	description: The set logo, the card’s code (number in its set), and its illustrator, designer, copyright, etc information.

