# NB. Each field is either:
#
# * "editable": what the user sees & clicks on.
#
# * "logical": important but derived fields, that we can use in scripts (whenever a separate field is necessary).
#
#    e.g. if {card.cardtype} is "GLACE: ", {card.type} is still "ice".
#
# * "UI": for the Card-List, Search-bar, Statistics-tab, etc (whenever a separate field is necessary).
#
# * "display".   
#
# The logical fields are:
#
# * card.type:
#
#   a constant from the stylesheet.
#   e.g. if the {card.stylesheet} is "netrunner-mnemic-runner-program.mse-style", {card.type} is "program".
#
# * card.name:
#
#   ≈ card.title + card.subtitle
#
# * card.faction:
#
#   = card.runner_faction | card.corp_faction
#
# * card.side
#
# The editable fields are:
#
# * card.art
# * card.title
# * card.subtitle
# * card.runner_faction
# * card.corp_faction
# * card.influence
# * card.cardtype
# * card.subtypes
# * card.text
# * card.fluff
# * card.unique
# * card.cost
# * card.trash
# * card.memory
# * card.strength
# * card.requirement
# * card.points
# * card.id_min_deck_size
# * card.id_max_influence
# * card.id_link_strength
# * card.id_pronouns
# * card.index
# * card.illustrator
# * card.designer
# * card.copyright
#
# The display fields include:
#
# * card.corners
# * card.logo
#
# The UI fields include:
#
# * card.cardlist_<FIELD>:
#
#   for prettifying the Cards List (NB. Unicode looks good, Emojis don't).
#   e.g. {card.cardlist_cost} prefixes a "$" to {card.cost}.
#
# * card.ascii_<FIELD>:
# 
#   for conveniencing the Search Bar.
#   e.g. if {card.title} is "Brân 2.0", then {card.ascii_name} is "bran 20", so you can search it up with "name:bran" or "m:20".
#
# * card.error
#
# * card.subcount
#
# {card.textbox} is a combined_editor, of {card.text} (rules text) plus {card.fluff} (flavor text).
# {card.footer} is a combined_editor too.
#
# 

############################## 

card field:
	type: text
	name: title

	script:
		stylesheet; styling;
		format_card_name(value, subtitle: card.subtitle)
	default: ""

	card list allow: false
	show statistics: false
	description: The card name.

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: subtitle

	card list allow: false
	show statistics: false
	description: Identities' subtitle (part of its name).

# # # # # # # # # # # # # # # 

card field:
	type: choice
	name: unique

	choice  : unique
	choice  : no
	initial : no

	card list allow: false
	show statistics: false
	description: Whether the installable card is unique (⬩). (Identities/Events/Operations are neither unique nor non-unique.)

##############################

card field:
	type: choice
	name: faction

	default: default_faction(this_side())
	default name: Neutral

	choice:
		name: anarch
		type: radio
		enabled: { is_card_runner() }
	choice:
		name: criminal
		type: radio
		enabled: { is_card_runner() }
	choice:
		name: shaper
		type: radio
		enabled: { is_card_runner() }

	choice:
		name: haas-bioroid
		type: radio
		enabled: { is_card_corp() }
	choice:
		name: jinteki
		type: radio
		enabled: { is_card_corp() }
	choice:
		name: nbn
		type: radio
		enabled: { is_card_corp() }
	choice:
		name: weyland
		type: radio
		enabled: { is_card_corp() }

	choice:
		name: adam
		type: radio
		enabled: { is_card_runner() and (set.enable_minifactions or else true) }
	choice:
		name: apex
		type: radio
		enabled: { is_card_runner() and (set.enable_minifactions or else true) }
	choice:
		name: sunny
		type: radio
		enabled: { is_card_runner() and (set.enable_minifactions or else true) }

	card list name      : faction
	card list column    : 0401
	card list visible   : true
	card list width     : 100
	choice colors cardlist:
		haas-bioroid : rgb(138, 43, 226)
		jinteki      : rgb(220, 20, 60)
		nbn          : rgb(255, 140, 0)
		weyland      : rgb(0,   100, 0)
		neutral-corp   : rgb(128, 128, 128)
		neutral-runner : rgb(192, 192, 192)
		anarch   : rgb(255, 69, 0)
		criminal : rgb(65, 105, 225)
		shaper   : rgb(50, 205, 50)
		adam  : rgb(167, 156, 89)
		apex  : rgb(140, 72, 71)
		sunny : rgb(120, 97, 150)

	show statistics: false
	description: The faction.

# # # # # # # # # # # # # # # 

card field:
	type: choice
	name: influence

	initial: 1
	choice:
		name: 5
		type: radio
	choice:
		name: 4
		type: radio
	choice:
		name: 3
		type: radio
	choice:
		name: 2
		type: radio
	choice:
		name: 1
		type: radio
	choice:
		name: 0
		type: radio

	card list name      : inf.
	card list column    : 0402
	card list visible   : true
	card list width     : 10

	show statistics: false
	description: The influence cost (0–5).

##############################

card field:
	type: text
	name: cardtype

	default  : this_type()
	script   : format_card_type(value, subtypes: card.subtypes)
	editable : false

	card list allow: false
	show statistics: false
	description: The card’s (single) card-type.
#TODO	editable: false

##############################

card field:
	type: text
	name: subtypes

	script:
		stylesheet; styling;
		format_subtypes(value)

	card list name    : sub-types
	card list column  : 0302
	card list width   : 200
	card list visible : true

	show statistics: false
	description: The card’s (zero-or-more) subtypes; hyphen-separated (e.g. "Icebreaker - AI - Virus").

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: text

	alt name: rules text
	alt name: abilities

	multi line: true
	script:
		stylesheet; styling;
		format_rules_text(value)

	card list allow: true
	show statistics: false
	description: Rules text, sharing the textbox with any flavor text (press down/up arrows to move between them). You can search your set for fields with any abbreviation (e.g. "x:run", since "(te)x(t)" is a distinct subsequence).

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: fluff

	alt name: flavor text

	multi line: true
	script:
		stylesheet; styling;
		format_flavor_text(value)

	card list allow: false
	show statistics: false
	description: Flavor text, sharing the textbox with any rules text (press up/down arrows to move between them).

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: box

	script: textbox_combined_editor()

	multi line: true
	save value: false

	card list allow: false
	show statistics: false
	description: The textbox, containing both rules text and flavor text. You can search your set for fields with any abbreviation (e.g. "x:run", since "(te)x(t)" is a distinct subsequence).

#TODO Uses {combined_editor()} because the flavor text comes (if present) a line below the rules text (not at the bottom of the textbox).

##############################

card field:
	type: text
	name: cost

	script:
		stylesheet; styling;
		only_numerals(value)

	card list allow: false
	show statistics: false
	description: The play/rez/install cost (in credits).

##############################
# Asset/Upgrade Fields:
# # # # # # # # # # # # # # # 

card field:
	type: text
	name: trash

	script:
		stylesheet; styling;
		only_numerals(value)
	sort script: compare_numeral(value)

	card list allow: false
	show statistics: false
	description: Assets'/Upgrades' trash cost (in credits). Operations/ICE can have one too.

##############################
# Program/ICE Fields:
# # # # # # # # # # # # # # # 

card field:
	type: text
	name: strength

	default     : if is_card_program() and not is_card_breaker() then "-" else ""
	script      : only_numerals(value)
	sort script : compare_numeral(value)

	card list name      : STR
	card list visible   : true
	card list column    : 0502
	card list width     : 10
	card list alignment : center middle

	show statistics: false
	description: The base strength of ICE/Icebreakers. Can be "X". Should be "-" for nom-Icebreaker Programs.

# # # # # # # # # # # # # # # 

card field:
	type: slider
	name: memory

	alt name: memory usage

	increment : 1
	minimum   : 0
	maximum   : 4

	default     : default_memory(card.type)
	script      : only_numerals(value)
	sort script : compare_numeral(value)

	card list allow: false
	show statistics: false
	description: Programs’ memory usage (mostly 1, 2, or 0).

##############################
# Agenda Fields:
# # # # # # # # # # # # # # # 

card field:
	type: text
	name: requirement

	alt name: agenda advancement requirement

	script:
		stylesheet; styling;
		only_numerals(value, digits: nil)
	sort script: compare_numeral(value)

	card list name    : Req.
	card list visible : false
	card list column  : 0504
	card list width   : 40

	card list allow: false
	show statistics: false
	description: Agendas’ advancement requirement (mostly 2, 3, 4, 5, or X).

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: points

	alt name: agenda point value

	script:
		stylesheet; styling;
		only_numerals(value)
	sort script: compare_numeral(value)

	card list name    : Pnt.
	card list visible : false
	card list column  : 0505
	card list width   : 40

	show statistics: false
	description: Agendas’ agenda-point value (mostly 1, 2, or 3).

##############################
# Identity Fields:
# # # # # # # # # # # # # # # 

card field:
	type: text
	name: id min deck size

	default: 45

	card list allow: false
	show statistics: false
	description: Identities’ minimum deck size. Corp decks with 40–44 cards need 18–19 agenda-points; 45–49 need 20–21, 50–54 need 22–23, and so on.

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: id max influence

	default: 15

	card list allow: false
	show statistics: false
	description: Identities’ maximum influence limit

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: subtitle

	card list allow: false
	show statistics: false
	description: Identities’ subtitle. Cards can have the same title if they have different subtitles, which form a card’s name (e.g. "Haas-Bioroid: Precision Design").

# # # # # # # # # # # # # # # 

card field:
	type: text
