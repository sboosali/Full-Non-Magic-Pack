
############################## 

card field:
	type: image
	name: art

	card list allow: false
	show statistics: false
	description: The artwork/illustration. The dimensions / aspect ratio differ between card-types, but most are "horizontal rectangles".

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: title

	default: ""

	card list allow: false
	show statistics: false
	description: The card name.

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: subtitle

	card list allow: false
	show statistics: false
	description: Identities' subtitle (part of its name).

# # # # # # # # # # # # # # # 

card field:
	type: choice
	name: unique

	choice  : unique
	choice  : no
	initial : no

	card list name    : ◆
	card list visible : true
	card list column  : 0901
	card list width   : 20

	show statistics: false
	description: Whether the installable card is unique (⬩). (Identities/Events/Operations are neither unique nor non-unique.)
#	sort script       : compare_boolean(value)

##############################

card field:
	type: choice
	name: faction

	default: "neutral-{ this_side() }"
	default name: Neutral

	choice:
		name: anarch
		type: radio
		enabled: { is_card_runner() }
	choice:
		name: criminal
		type: radio
		enabled: { is_card_runner() }
	choice:
		name: shaper
		type: radio
		enabled: { is_card_runner() }

	choice:
		name: haas-bioroid
		type: radio
		enabled: { is_card_corp() }
	choice:
		name: jinteki
		type: radio
		enabled: { is_card_corp() }
	choice:
		name: nbn
		type: radio
		enabled: { is_card_corp() }
	choice:
		name: weyland
		type: radio
		enabled: { is_card_corp() }

	choice:
		name: adam
		type: radio
		enabled: { set.enable_minifactions and is_card_runner() }
	choice:
		name: apex
		type: radio
		enabled: { set.enable_minifactions and is_card_runner() }
	choice:
		name: sunny
		type: radio
		enabled: { set.enable_minifactions and is_card_runner() }

	card list name      : faction
	card list column    : 0401
	card list visible   : true
	card list width     : 100
	choice colors cardlist:
		haas-bioroid : rgb(138, 43, 226)
		jinteki      : rgb(220, 20, 60)
		nbn          : rgb(255, 140, 0)
		weyland      : rgb(0,   100, 0)
		neutral-corp   : rgb(128, 128, 128)
		neutral-runner : rgb(192, 192, 192)
		anarch   : rgb(255, 69, 0)
		criminal : rgb(65, 105, 225)
		shaper   : rgb(50, 205, 50)
		adam  : rgb(167, 156, 89)
		apex  : rgb(140, 72, 71)
		sunny : rgb(120, 97, 150)

	show statistics: false
	description: The faction.

# # # # # # # # # # # # # # # 

card field:
	type: choice
	name: influence

	initial: 1
	choice:
		name: 5
		type: radio
	choice:
		name: 4
		type: radio
	choice:
		name: 3
		type: radio
	choice:
		name: 2
		type: radio
	choice:
		name: 1
		type: radio
	choice:
		name: 0
		type: radio

	card list name      : inf.
	card list column    : 0402
	card list visible   : true
	card list width     : 10

	show statistics: false
	description: The influence cost (0–5).

##############################

card field:
	type: text
	name: cardtype

	default : this_type()
	script  : format_card_type(value, subtypes: card.subtypes)

	card list allow: false
	show statistics: false
	description: The card’s (single) card-type.

# # # # # # # # # # # # # # # 



##############################

card field:
	type: text
	name: subtypes

	card list name      : sub-types
	card list column    : 0302
	card list width     : 400

	show statistics: false
	description: The card’s (zero-or-more) subtypes; hyphen-separated (e.g. "Icebreaker - AI - Virus").

	script: format_subtypes(value, type: card.type)
#	script: subtypes_combined_editor()

##############################

card field:
	type: text
	name: text

	multi line: true
	script:
		stylesheet
		format_rules_text(value)

	show statistics: false
	description: Rules text, sharing the textbox with any flavor text (press down/up arrows to move between them). You can search your set for fields with any abbreviation (e.g. "x:run", since "(te)x(t)" is a distinct subsequence).

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: flavor

	multi line: true
	script:
		stylesheet
		format_flavor_text(value)

	show statistics: false
	description: Flavor text, sharing the textbox with any rules text (press up/down arrows to move between them).

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: box

	save value: false
	script: textbox_combined_editor()
	multi line: true

	show statistics: false
	description: The textbox, containing both rules text and flavor text. You can search your set for fields with any abbreviation (e.g. "x:run", since "(te)x(t)" is a distinct subsequence).

#TODO Uses {combined_editor()} because the flavor text comes (if present) a line below the rules text (not at the bottom of the textbox).

##############################

card field:
	type: text
	name: cost

	script      : only_numerals(value)
	sort script : compare_numeral(value)

	card list name      : $$$
	card list visible   : true
	card list column    : 0201
	card list width     : 15
	card list alignment : center middle

	show statistics: false
	description: The play/rez/install cost (in credits).

##############################
# Asset/Upgrade Fields:
# # # # # # # # # # # # # # # 

card field:
	type: text
	name: trash

	script      : only_numerals(value)
	sort script : compare_numeral(value)

	card list name    : 🗑️ Trash
	card list visible : true
	card list column  : 0501
	card list width   : 40

	description: Assets'/Upgrades' trash cost (in credits). Operations/ICE can have one too.

##############################
# Program/ICE Fields:
# # # # # # # # # # # # # # # 

card field:
	type: text
	name: strength

	default     : if is_card_program() and not is_card_breaker() then "-" else ""
	script      : only_numerals(value)
	sort script : compare_numeral(value)

	card list name      : STR
	card list visible   : true
	card list column    : 0502
	card list width     : 10
	card list alignment : center middle

	show statistics: false
	description: The base strength of ICE/Icebreakers. Can be "X". Should be "-" for nom-Icebreaker Programs.

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: memory

	default     : if is_card_program() then "1" else ""
	script      : only_numerals(value)
	sort script : compare_numeral(value)

	card list name      : MU
	card list visible   : true
	card list column    : 0503
	card list width     : 10
	card list alignment : center middle

	show statistics: false
	description: Programs’ memory usage (mostly 1, 2, or 0).

##############################
# Agenda Fields:
# # # # # # # # # # # # # # # 

card field:
	type: text
	name: requirement

	script      : only_numerals(value)
	sort script : compare_numeral(value)

	card list name    : Rq./_
	card list visible : true
	card list column  : 0504
	card list width   : 40

	description: Agendas’ advancement requirement (mostly 2, 3, 4, 5, or X).

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: points

	script      : only_numerals(value)
	sort script : compare_numeral(value)

	card list name    : _/Pt.
	card list visible : true
	card list column  : 0505
	card list width   : 40

	description: Agendas’ agenda-point value (mostly 1, 2, or 3).

##############################
# Identity Fields:
# # # # # # # # # # # # # # # 

card field:
	type: text
	name: id min deck size

	default: 45

	show statistics: false
	description: Identities’ minimum deck size. Corp decks with 40–44 cards need 18–19 agenda-points; 45–49 need 20–21, 50–54 need 22–23, and so on.

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: id max influence

	default: 15

	show statistics: false
	description: Identities’ maximum influence limit

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: id link strength

	show statistics: false
	description: Runner identities’ base link strength (mostly 0).

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: subtitle

	show statistics: false
	description: Identities’ subtitle. Cards can have the same title if they have different subtitles, which form a card’s name (e.g. "Haas-Bioroid: Precision Design").

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: id pronouns

	show statistics: false
	description: Runner identities’ pronouns (e.g. "they/them").

##############################

card field:
	type: text
	name: footer

	multi line: false

	show statistics: false
	description: The set logo, the card’s code (number in set), and its illustrator, designer/copyright, and other information.
#	script: footer_combined_editor()

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: illustrator

	script: if value!="" then "" else "<align:center>✎ des. { value }</align>"

	card list name      : art
	card list column    : 9900
	card list visible   : false
	card list width     : 200

	show statistics: false
	description: Who illustrated the card's artwork.

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: designer

	script: if set.designer=="" then "" else "<align:right>🖌 illus. { set.designer }</align>"

	save value : false
	editable   : true

	show statistics: false
	description: Who designed the card.

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: copyright

	save value : false
	editable   : true

	show statistics: false
	description: Under what will the released card be licensed.

# # # # # # # # # # # # # # # 

card field:
	type: image
	name: logo

	save value : false
	editable   : false

	show statistics: false
	description: 

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: index

	script: if set.automatic_card_numbers then card_index_text() else value

	save value : false
	editable   : true

	card list name      : /
	card list visible   : true
	card list column    : 10
	card list width     : 50
	card list alignment : right

	show statistics: false
	description: 
#	script:      card_index() + " / " + number_of_items(in: set, filter: is_real_card)

##############################

card field:
	type: image
	name: corners

	card list allow: false
	show statistics: false

##############################
# Virtual "Data" Fields:
# # # # # # # # # # # # # # #

card field:
	type: text
	name: name

	identifying: true
	script: name_of(title: card.title, subtitle: card.subtitle)

	sort script         : compare_name(value)
	card list name      : name
	card list column    : 0101
	card list visible   : true
	card list width     : 1000

	show statistics: false

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: side

	script: this_side()

	sort script         : compare_side(value)
	card list name      : side
	card list column    : 0403
	card list visible   : false
	card list width     : 100

	show statistics: false

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: type

	script: this_type()

	sort script         : compare_type(value)
	card list name      : card-type
	card list visible   : true
	card list column    : 0301
	card list width     : 100
	card list alignment : right

	show statistics: false

# # # # # # # # # # # # # # # 



