card field:
	type: text
	name: cardlist cost

	script      : if card.cost!="" then "${ card.cost }" else ""
	sort script : compare_numeral(card.cost)

	card list name      : $ cost
	card list visible   : true
	card list column    : 0201
	card list width     : 40
	card list alignment : center middle

	show statistics: false

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: cardlist trash

	script      : if card.trash!="" then "${ card.trash }" else ""
	sort script : compare_numeral(card.trash)

	card list name      : $ trash
	card list visible   : true
	card list column    : 0501
	card list width     : 40
	card list alignment : center middle

	show statistics: false

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: cardlist memory

	script      : if card.memory!="" then "{ card.memory }mu" else ""
	sort script : compare_numeral(card.memory)

	card list name      : mu
	card list visible   : true
	card list column    : 0503
	card list width     : 30
	card list alignment : center middle

	show statistics: false

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: cardlist side

	script      : cardlist_side(card.side)
	sort script : compare_side(card.side)

	card list name      : sd.
	card list column    : 0403
	card list visible   : true
	card list width     : 20

	show statistics: false

