# Virtual "Search" Fields:
# # # # # # # # # # # # # # #

card field:
	type: text
	name: card name ascii
	script: asciify(card.name)
	card list allow: false
	show statistics: false

card field:
	type: text
	name: card name acronym
	script: acronymize(asciify(card.name))
	card list allow: false
	show statistics: false

