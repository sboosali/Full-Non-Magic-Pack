	card list allow: false
	show statistics: false
	description: Runner identities’ base link strength (mostly 0).

# # # # # # # # # # # # # # # 

card field:
	type: text
	name: id pronouns

	card list allow: false
	show statistics: false
	description: Runner identities’ pronouns (e.g. "they/them").

