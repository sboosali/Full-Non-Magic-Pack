
##############################

has keywords: true

keyword match script: format_reminder_text(value)

##############################

keyword mode:
	name: action
	is default: true
	description: Custom keyword actions, with reminder text at end-of-line.

keyword mode:
	name: official
	description: Official keyword actions (e.g. `Sabotage N`, `Charge …`, `Identify your mark`).

keyword mode:
	name: rule
	description: Intrinsic keyword actions to the game rules (e.g. `Purge virus counters`). Reminder text is hidden by default.

keyword mode:
	name: flag
	description: Keyword flags (e.g. `Threat N → …`). Case-sensitive, between start-of-line and a right-arrow.

keyword mode:
	name: ability
	description: “Keyword abilities” (e.g. `Dividends 1`, `Hidden`). At start-of-line, in a comma-separated list.

keyword mode:
	name: phrase
	description: “Keyword phrases” (e.g. `unique (⬥)`). Reminder text follows immediately afterwards.

##############################

keyword parameter type:
	name: number
	match: [0-9XYZN]
	refer script:
		name: normal
		description: Matches a natural number (positive integer) or a “variable letter” (X,Y,Z,N). e.g. (1,2,3,X).
		script: \{{input}\}
	refer script:
		name: as words
		description: e.g. (one, two, three, X)
		script: \{english_number({input})\}
	refer script:
		name: as words, use "a" for 1
		description: e.g. (a, two, three)
		script: \{english_number_a({input})\}
	refer script:
		name: as words, use "" for 1
		description: e.g. (, two, three)
		script: \{english_number_multiple({input})\}
	refer script:
		name: as ordinal words
		description: e.g. (first, second, third)
		script: \{english_number_ordinal({input})\}

# # # # # # # # # # # # # # # 

keyword parameter type:
	name: word
	match: [A-Za-z0-9_-]+

# # # # # # # # # # # # # # # 

keyword parameter type:
	name: deck
	match: (R&D|(the|your|their) stack)

keyword parameter type:
	name: hand
	match: (HQ|(the|your|their) grip)

keyword parameter type:
	name: pile
	match: (Archives|(the|your|their) heap)

##############################

keyword:
	keyword: Sabotage
	match: sabotage <atom-param>number</atom-param>
	mode: official
	reminder: The Corp trashes {param1} card{ if (param1.value=="1") then "" else "s" } of their choice from HQ { if (param1.value=="1") then "or" else "and/or" } the top of R&D.

##############################

keyword:
	keyword: Threat
	match: Threat <atom-param>number</atom-param>
	mode: flag
	reminder: This ability is active if any player has {param1} or more agenda points.

##############################

keyword:
	keyword: Bypassing
	match: bypass
	mode: rule
	reminder: Pass that ice. No subroutines or further "when encountered" abilities resolve.

##############################

keyword:
	keyword: Unique
	match: unique
	mode: phrase
	reminder: <sym>unique</sym>

