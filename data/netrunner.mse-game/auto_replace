##############################

auto replace:
	match   : --
	replace : →
#	match  : ->

auto replace:
	match   : *
	replace : •

auto replace:
	match   : MIN
	replace : −

auto replace:
	match   : INF
	replace : ∞

auto replace:
	match   : ENN
	replace : –

auto replace:
	match   : EMM
	replace : —

##############################

auto replace:
	match   : ==
	replace : <sym>subroutine</sym>
#	match  : =>

##############################

auto replace:
	match   : 1c
	replace : 1<atom-symbol><sym>credit</sym></atom-symbol>

##############################

auto replace:
	match   : r2
	replace : 2<sym>recurring</sym> (When you rez this <atom-this-type>card</atom-this-type> and <b-auto>before</b-auto> your turn begins, refill to 2 hosted credits.)
#	replace : 2<sym>recurring</sym> (When you rez this <atom-this-type>card</atom-this-type> and before your turn begins, refill to { param1 } hosted credit{ if param1=="1" then "" else "s" }.)\nYou can spend hosted credits 

auto replace:
	match   : rr2
	replace : (When you rez this <atom-this-type>card</atom-this-type> and before your turn begins, refill to 2 hosted credits.)

##############################

auto replace:
	match   : ccc
	replace : When you install this <atom-this-type>card</atom-this-type>, load _<sym>credit</sym> onto it. When it is empty, trash it.

