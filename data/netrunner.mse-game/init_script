# e.g. "brain(?= damage)" means: match "brain damage" but only mark "brain".
# n.b. the "(?=)" is a "lookahead assertion".
#

mistemplatings := [

	"illicit",

	"brain(?= damage)",
	"(?<=draw )(an?|one|two|three|four|five)(?= cards?)",
	"(?<=virus )token|(?<=power )token|(?<=advancement )token|(?<=agenda )token",

	"can be advanced"
]

# # # # # # # # # # # # # # # 

# Mark obsolete rules-text and common mis-templatings.
#
# e.g. "When this resource is installed" (-> "When you install this resource").
# e.g. the "Illicit" subtype (-> "Liability"), "brain damage" (-> "core damage"), "advancement token" (-> "advancement counter"), and so on.
# e.g. the "Illicit" subtype ("Liability"), "brain damage" ("core damage"), "advancement token" ("advancement counter"), and so on.
#

check_templating := {

	mistemplating_rx := "(?i)\\b{ join(mistemplatings, sep:"|") }\\b"

	replace(input, match: mistemplating_rx, replace: "<error-templating>\\0</error-templating>")

}

