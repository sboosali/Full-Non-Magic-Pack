add_subtype_dropdowns := {

	ts := split_subtypes(input, include_empty: true, no_trim: true)
	t0 := ts[0] or else ""
	n  := length(ts)

	ts := for i from 0 to n-1 do
		[ add_subtype_dropdown(ts[i], position: i+1, first: t0, type: type, side: side) ]

	#TODO suffix := add_subtype_dropdown("<soft> </soft>", position: n, first: t0, type: type, side: side)

	subtypes := join_subtypes(ts + [])
	subtypes := if subtypes=="Icebreaker" then "{ subtypes } - " else subtypes 
	subtypes

}@(lang: "en", type: nil, side: nil)

