# e.g. from_csv ("x,y ,  z,")
#   == ["x", "y", "z"]

from_csv := split_text@(match: "[ ]*,[ ]*", include_empty: false)

# # # # # # # # # # # # # # # 

join := {
	n := length(input)-1

	if n < 0 then ""

	else for i from 0 to n do (
		s := if i == n then "" else sep
		input[i] + s
	)
}@(sep: ",")

# # # # # # # # # # # # # # # 

# Joins ["x", "y", "z"] into "x,y,z".

to_csv := join@(sep:",")

# # # # # # # # # # # # # # # 

csv_to_rx := { "\\b{ join(from_csv(input), sep:"|") }\\b" }

