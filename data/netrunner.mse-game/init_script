# Strip accents/etc.
#
# e.g. asciify("Brân 1.0")
#   == "Bran 1.0"
#

asciify :=

	asciify_a
	+
	asciify_e
	+
	asciify_i
	+
	asciify_o
	+
	asciify_u

	+
	asciify_c
	+
	asciify_n
	+
	asciify_y

	+
	asciify_ss
	+
	asciify_ae
	+
	asciify_oe
	+
	asciify_ue

# # # # # # # # # # # # # # # 

# Drop "non-letter" characters.
