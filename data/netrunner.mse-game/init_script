parse_numeral := {

	n := parse_number(card.cost) or else -1

	if n>=0
	then n

	else if match_variable(input)
	then input

	else ""
}

# # # # # # # # # # # # # # # 

# Convert a numeral string (e.g. "1", "X", "   ") to a cost number (e.g. 1, 0, or -1 (resp.)).

convert_numeral := {

	n := parse_number(card.cost) or else -1

	if n>=0
	then n

	else if match_variable(input) or match_dash(input)
	then 0

	else -1
}

