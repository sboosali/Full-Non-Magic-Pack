		"agenda"    : tag_wordlist(list: "agenda-type", input, lang: lang),
		"ice"       : add_ice_type_dropdown(input, position: position, lang: lang),
		"asset"     : tag_wordlist(list: "asset-type", input, lang: lang),
		"upgrade"   : tag_wordlist(list: "upgrade-type", input, lang: lang),

		"identity": (case normalize_side(side) of 
			"runner" : tag_wordlist(list: "runner-identity-type", input, lang: lang),
			"corp"   : tag_wordlist(list: "corp-identity-type", input, lang: lang),
			else     : tag_wordlist(input, lang: lang)),

