keyword_modes_after_line_rx     := csv_to_rx("flag, ability")

# # # # # # # # # # # # # # # 

# Find the nearest (following) end-of-sentence, a period or end-of-line;
# TODO skipping abbreviation periods.

eos_rx := "[.](?= )|[.]$"

# # # # # # # # # # # # # # # 

# Keyword actions' reminder-text comes at end-of-sentence (see Time Bomb).

relocate_reminder_text_after_sentence := replace@(
	replace: "\\2\\3\\1",
	match: "(<atom-reminder-(?:{ keyword_modes_after_sentence_rx })> (?:(?!</kw).*?)</atom-reminder-(?:{ keyword_modes_after_sentence_rx })></kw[^>]*>)([^.\n]*)({ eos_rx })"
)

# # # # # # # # # # # # # # # 

# Keyword flags & abilities' reminder-text comes at end-of-line.

relocate_reminder_text_after_line := replace@(
	replace: "\\2\\1",
	match: "(<atom-reminder-(?:{ keyword_modes_after_line_rx })> (?:(?!</kw).*?)</atom-reminder-(?:{ keyword_modes_after_line_rx })></kw[^>]*>)([^\n]*)$"
)

# # # # # # # # # # # # # # # 

relocate_reminder_text :=
	{ input }
	+ relocate_reminder_text_after_sentence
	+ relocate_reminder_text_after_line

