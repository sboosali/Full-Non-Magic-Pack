# Card-List:
# # # # # # # # # # # # # # # 

# Sorts "X" before "0"/"1"/etc and "-" after (for costs/strengths/points/etc, up to 1000).
# 
# e.g. compare_numeral("3")
#   == "B+03"
# 

compare_numeral := {
	s := to_text(input)
	n := if s=="" then false else (to_number(s) or else false)

	if s=="X" or s=="Y" or s=="Z"
	then "A" + to_string(s, format: "%-3s")

	else if n != false
	then "B" + to_string(n, format: "+03d")

	else if s=="-" or s=="–" or s=="—"
	then "C   "

	else "Z   "
}

# # # # # # # # # # # # # # # 

compare_boolean := {
	s := to_text(input)

	if s=="yes"
	then "A"

	if s=="no"
	then "C"

	else "B{ to_string(s) }"
}

