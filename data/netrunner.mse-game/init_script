asciify_a := replace@(replace: "a", match: "(?i)[áàâäāãåậăąǎǟǡǻȁȃȧẚạảấầẩẫậắằẳẵặḁ]")

asciify_e := replace@(replace: "e", match: "(?i)[éèêëē]")
asciify_i := replace@(replace: "i", match: "(?i)[íìîïī]")
asciify_o := replace@(replace: "o", match: "(?i)[óòôöōõø]")
asciify_u := replace@(replace: "u", match: "(?i)[úùûüū]")

asciify_c := replace@(replace: "c", match: "(?i)[ç]")
asciify_n := replace@(replace: "n", match: "(?i)[ñ]")
asciify_y := replace@(replace: "y", match: "(?i)[ý]")

