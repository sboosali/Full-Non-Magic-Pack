embolden_subtypes := {

	input := replace(input,

		replace: "<b-auto>\\1</b-auto>",
		match: "(?i){ subtype_rx() }"

	)

	input := replace(input,

		replace: "<b-auto>\\0</b-auto>",
		match: "(?i)\\b(run(?= event)|virus(?! counter))"

	)

	input
}

