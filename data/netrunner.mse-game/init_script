# Validation:
# # # # # # # # # # # # # # # 

only_numerals := filter_text@(match: "(?i)^[0-9X-Z]+") + to_upper

##############################
# Sorting:
# # # # # # # # # # # # # # # 

# Sorts "X" before "0"/"1"/etc and "-" after (for costs/strengths/points/etc, up to 1000).
# 
# e.g. compare_numeral("3")
#   == "B+003"
# 

compare_numeral := {
	s := to_text(input)
	n := to_number(s) or else false

	if s=="X" or s=="Y" or s=="Z"
	then "A" + s

	else if n != false
	then "B" + to_string(n, format: "+03d")

	else if s=="-"
	then "C"

	else "Z"
}

##############################
# Formatting:
##############################
# Bold:

# Collects any custom subtypes implicitly written in the set or
# explicitly registered in the Set Info panel, as well as the official subtypes.

all_subtypes := {

	xs := official_subtypes
	ys := from_csv(set.subtypes)
	zs := custom_subtypes()

	subtypes := sort_list(xs + ys + zs, remove_duplicates: true)
	subtypes := ambiguous_subtypes (subtypes)
	subtypes
}

# # # # # # # # # # # # # # # 

custom_subtypes := {
	for each card in set do
		subtypes := split_subtypes(to_text(card.subtypes))
		subtypes
}

# # # # # # # # # # # # # # # 

subtype_rx := {

	"\\b({ join(all_subtypes(), sep: "|") })\\b"

}

# # # # # # # # # # # # # # # 

embolden_subtypes := {
	replace(input,

		replace: "<b>\\1</b>",
		match: subtype_rx()

	)
}

# # # # # # # # # # # # # # # 

embolden_activation_costs := replace@(

	replace: "<b>\\1</b>",
	match: "^(?:[a-z0-9_+<>-]+ → )?([^:\\n]+:)"

)

##############################
# Italics:

reminder_rx := "\\([^\\)\\n]*\\)"

# # # # # # # # # # # # # # # 

italicize_parentheticals := replace@(match: reminder_rx, replace: "<i>\\0</i>")

italicize_reminder_text  := italicize_parentheticals

# e.g. "[click]" → "<sym>click</sym>"

##############################
# Symbols:

expand_symbols := replace@(
	replace: "<sym>\\1</sym>",
	match: "\\[([_a-zA-Z0-9]+)\\]"
)

##############################
# Format:

format_rules_text :=

	expand_symbols
	+

	remove_tag@(tag: "<b>")
	+
	embolden_subtypes
	+
	embolden_activation_costs
	+

	remove_tag@(tag: "<i>")
	+
	italicize_parentheticals
	+

	curly_quotes

# # # # # # # # # # # # # # # 

format_flavor_text :=

	remove_tag@(tag: "<i-flavor>")
	+
	{ "<i-flavor>" + input + "</i-flavor>" }
	+
	curly_quotes

# # # # # # # # # # # # # # # 

# 

format_reminder_text :=

	expand_symbols
	+
	curly_quotes

