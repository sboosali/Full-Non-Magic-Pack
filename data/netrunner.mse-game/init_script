	faction   := input.faction_id or else input.faction_code or else input.faction or else "neutral"
	influence := input.influence_cost or else input.faction_cost or else input.influence or else "0"

	cost     := to_string(input.cost) or else to_string(input.play_cost) or else to_string(input.install_cost) or else to_string(input.rez_cost) or else ""
	trash    := to_string(input.trash_cost) or else to_string(input.trash) or else ""
	memory   := to_string(input.memory_cost) or else ""
	strength := to_string(input.strength) or else ""

	agenda_points           := to_string(input.agenda_point_value) or else ""
	advancement_requirement := to_string(input.advancement_requirement) or else ""

	unique     := input.is_unique or else input.uniqueness or else false
	deck_limit := to_int(input.deck_limit) or else 3

	text := input.rules_text or else input.text or else ""

	#

	flavor      := input.flavor_text or else input.flavor or else ""
	illustrator := input.illustrator or else ""
	#  := input.notes or else ""

	#

	fields := [ name: title, cost: cost, memory: memory, type: type, subtypes: subtypes, faction: faction, influence: influence, side: side, unique: unique, text: text, subtitle: subtitle ]

	fields := fields + (if deck_limit == 3 then [] else [ deck_limit: input.deck_limit ])

	new_card(fields)
}

