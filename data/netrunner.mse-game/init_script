nr_expand_keywords := expand_keywords@(

	default_expand: { chosen(choice: mode, set.automatic_reminder_text) },

	condition: { (not used_placeholders) },

	combine: { "{ keyword }<atom-reminder-{mode}> ({ reminder })</atom-reminder-{mode}>" })
