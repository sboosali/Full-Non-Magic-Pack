combine_keyword_with_reminder_text := {

	keyword := "<nospellcheck>{ keyword }</nospellcheck>"
	reminder := process_english_hints(reminder)

	if (mode == "action")
	then reminderize(keyword: keyword, reminder: reminder, mode: "action", expand: expand)

	else	
	""
}

