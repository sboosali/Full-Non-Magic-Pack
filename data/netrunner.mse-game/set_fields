
##############################

set field:
	type: info
	name: Set Info

set field:
	type: text
	name: title
	description: Set Title (e.g. "Neuromancer"). Can't be an official set.

set field:
	type: text
	name: description
	multi line: true
	description: Your set's design goals, novel mechanics, its world-building, what motivated you, whether it's been playtested, any changelogs, and so on.

##############################

set field:
	type: info
	name: Set Metadata

set field:
	type: text
	name: code
	description: Set Code (e.g. "neur"); 3-5 letters/numbers. Can't shadow an official set.

set field:
	type: text
	name: index
	description: Set Index (e.g. "69"). Can't shadow an official set (n.b. Vantage Point was at "36").

set field:
	type: symbol
	name: logo
	#initial: "MagnumOpus.png"
	description: Set Logo (symbol). Shown in cards’ footer. (By default, the alchemical "Magnum Opus" symbol.)

set field:
	type: choice
	name: language
	initial: "en-US"
	choice: "en-US"
	choice: "fr-FR"
	description: Language code (e.g. "fr-FR") of all text name/rules/flavor/typeline/etc American English ("en-US") by default. [please help with localization!]

set field:
	type: text
	name: copyright
	description: Copyright information (e.g. "CC0 2026 Gilliam Bibson"): the designer(s) of this set. Illustrators have separate attribution on each card.

##############################

set field:
	type: info
	name: Set Styling

set field:
	type: package choice
	name: textbox symbols
	match: netrunner-*-symbols.mse-symbol-font
	initial: /netrunner-ffg-symbols.mse-symbol-font
	description: Game symbols (the [credit] diamond, [click] clock, [trash] can, etc).

# set.textbox_symbols

set field:
	type: text
	name: subtypes
	description: Extra subtypes, to be auto-emboldened; a comma-separated value (e.g. "Nanotech, SimStim, Black ICE, Jockey,").

##############################

set field:
	type: info
	name: Set Editing

set field:
	type: multiple choice
	name: automatic reminder text
	initial: action, flag, phrase, 
	choice: action
	choice: official
	choice: flag
	choice: ability
	choice: phrase
	choice: rule
	description: For which "keyword modes" should reminder text be auto-expanded? (You can still toggle reminder text on/off by right clicking a keyword on any card.)

set field:
	type: boolean
	name: automatic card numbers
	initial: yes
	description: Show card number (e.g. "001") on each card's footer?

##############################

default set style:

	title:
		padding left: 2
		font:
			size: 12

	description:
		font:
			size: 8

	textbox symbols:
		#render style: both

	automatic reminder text:
		render style: checklist
		direction: vertical

##############################
