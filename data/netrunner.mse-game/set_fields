
##############################

set field:
	type: info
	name: Set Info

set field:
	type: text
	name: title
	description: Set Title (e.g. "Neuromancer"). Can't be an official set.

set field:
	type: text
	name: description
	multi line: true
	description: Your set's design goals, novel mechanics, its world-building, what motivated you, whether it's been playtested, any changelogs, and so on.

##############################

set field:
	type: info
	name: Set Metadata

set field:
	type: text
	name: code
	description: Set Code (e.g. "neur"); 3-5 letters/numbers. Can't shadow an official set.

set field:
	type: text
	name: index
	description: Set Index (e.g. "69"). Can't shadow an official set (n.b. Vantage Point was at "36").

set field:
	type: symbol
	name: logo
	description: Set Logo (symbol). Shown in cards’ footer. NOTE! To import a PNG, after setting its transparency to white, you must filter for "Images/MSE1 files" (under the bottom-right corner of the Open File dialog). By default, the alchemical "Magnum Opus" symbol.
#	default: "magnum_opus.mse-symbol"

set field:
	type: text
	name: designer
	description: The designer(s) of this set (e.g. "Gilliam Bibson"). Illustrators have separate attribution on each card.

set field:
	type: text
	name: copyright
	default: "CC0"
	description: Under what copyright the cards themselves should be licensed (e.g. "CC0 2026"). Abbreviated: e.g. "CC0" for public domain, "©" for all rights reserved, etc.

##############################

set field:
	type: info
	name: Card Styling

set field:
	type: package choice
	name: textbox symbols
	match: netrunner-*-symbols.mse-symbol-font
	initial: /netrunner-ffg-symbols.mse-symbol-font
	description: Game symbols (the [credit] diamond, [click] clock, [trash] can, etc).

set field:
	type: boolean
	name: automatic card numbers
	initial: yes
	description: Show card number (e.g. "001") on each card's footer, automatically?

set field:
	type: text
	name: extra subtypes
	description: Whitelist of extra subtypes to auto-embolden. Is a comma-separated value (e.g. "Nanotech, SimStim, Black ICE, Jockey,").

set field:
	type: text
	name: ambiguous subtypes
	default: "Run,Sabotage,"
	description: Blacklist of subtypes to NOT auto-embolden. "Run, Sabotage," by default. n.b. You can still manually bold (or unbold) any words; e.g. for "**run** event".

set field:
	type: boolean
	name: color subtypes
	initial: no
	description: Color the words "barrier"/"sentry"/"code gate" as their associated faction (for visual clarity). e.g. "Barrier" becomes dark-green like Weyland (such as in the rules-text of Fracters).

set field:
	type: boolean
	name: enable minifactions
	initial: no
	description: Whether the set has Adam/Apex/Sunny.

##############################

set field:
	type: info
	name: Set Editing

set field:
	type: multiple choice
	name: automatic reminder text
	initial: action, flag, phrase, 
	choice: action
	choice: official
	choice: flag
	choice: ability
	choice: phrase
	choice: rule
	description: For which "keyword modes" should reminder text be auto-expanded? (You can still toggle reminder text on/off by right clicking a keyword on any card.)

set field:
	type: multiple choice
	name: checking
	initial: check spelling, check templating
	choice: check spelling
	choice: check templating
	description: Mark mis-spellings and/or mis-templatings (with a wavy red underline). e.g. the word "token" in the phrase "advancement token" (which should be "counter").

##############################

set field:
	type: info
	name: Help

set field:
	type: text
	name: help
	multi line: true
	editable: false
	description: To

##############################

default set style:

	title:
		padding left: 2
		font:
			size: 12

	description:
		font:
			size: 8

	automatic reminder text:
		render style: checklist
		direction: vertical

	checking:
		render style: checklist
		direction: vertical

	logo:
		variation:
			name: white
			fill type: solid
			fill color: rgb(255,255,255)
			border radius: 0.05
			border color: rgb(0,0,0)


