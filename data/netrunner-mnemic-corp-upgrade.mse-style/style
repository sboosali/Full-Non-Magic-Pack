##############################

include file: /netrunner-mnemic-common.mse-include/default_style

styling field:
	type: text
	name: trash cost scale
	description: How many times larger should the trashcan be? e.g. 1.2 (defaults to 1.0).

##############################

card style:


	faction:
		left : 0
		top  : 0
		width  : 750
		height : 1050
		z index: 0
		render style : image
		popup style  : in place

		choice images:
			haas-bioroid : CorpUpgradeDefaultHB.png
			jinteki      : CorpUpgradeDefaultJinteki.png
			nbn          : CorpUpgradeDefaultNBN.png
			weyland      : CorpUpgradeDefaultWeyland.png
			neutral-corp : CorpUpgradeDefaultNeutral-Corp.png


	influence:
		left : { if card.faction=="neutral-corp" then 33 else 107 }
		top  : 992
		width  : 210
		height : 42
		z index : 3
		tab index: 9
		render style : image
		popup style  : in place
		choice images:
			5: /netrunner-mnemic-common.mse-include/IconInfluence5Horizontal.png
			4: /netrunner-mnemic-common.mse-include/IconInfluence4Horizontal.png
			3: /netrunner-mnemic-common.mse-include/IconInfluence3Horizontal.png
			2: /netrunner-mnemic-common.mse-include/IconInfluence2Horizontal.png
			1: /netrunner-mnemic-common.mse-include/IconInfluence1Horizontal.png
			0: /netrunner-mnemic-common.mse-include/IconInfluence0Horizontal.png


	cost:
		left : 0
		top  : 0
		width  : 170
		height : 170
		padding left   : 70
		padding top    : 61
		padding right  : 59
		padding bottom : 51
		z index: 3
		alignment: center middle
		tab index: 2
		font:
			name  : BankGothicBT-Medium
			size  : 64
			color : rgb(255, 255, 255)


	trash:
		left   : { 642 + (86 * (1 - parse_number(styling.trash_cost_scale, default: 1.0))) }
		top    : { 896 + (78 * (1 - parse_number(styling.trash_cost_scale, default: 1.0))) }
		width  : { 86  *            parse_number(styling.trash_cost_scale, default: 1.0) }
		height : { 78  *            parse_number(styling.trash_cost_scale, default: 1.0) }
		padding left   : { 25  * parse_number(styling.trash_cost_scale, default: 1.0) }
		padding top    : { 15  * parse_number(styling.trash_cost_scale, default: 1.0) }
		padding right  : { 10  * parse_number(styling.trash_cost_scale, default: 1.0) }
		padding bottom : { 10  * parse_number(styling.trash_cost_scale, default: 1.0) }
		z index: 4
		alignment: center middle
		tab index: 3
		font:
			name  : Impact
			size  : { 48 * parse_number(styling.trash_cost_scale, default: 1.0) }
			color : rgb(129, 119, 106)


	footer:
		left : { if card.faction=="neutral-corp" then 255 else 329 }
		top  : 991
		right  : 740
		bottom : 1046
		z index: 2
		alignment: center middle
		tab index: 10
		font:
			name  : Arial Narrow
			size  : 14
			color : rgb(255, 255, 255)


