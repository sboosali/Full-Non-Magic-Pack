version         : 2026-10
game            : netrunner
short name      : Upgrade
full name       : Corp/Upgrade (MNeMiC)
position hint   : -1
installer group : Netrunner/MNeMiC templates/Corp Upgrade
icon            : preview.jpg

depends on: netrunner.mse-game                    2026-10
